switch (indice) {
    case 0:
        sprite_index = spr_carta1;
        break;
    case 1:
        sprite_index = spr_carta2;
        break;
    case 2:
        sprite_index = spr_carta3;
        break;
    case 3:
        sprite_index = spr_carta4;
        break;
    default:
        sprite_index = spr_carta1;
        break;
}
