// Captura a escala original da room (editada no Room Editor)
tamanho_original_x = image_xscale;
tamanho_original_y = image_yscale;

// Define multiplicadores de hover (ex: +10% de zoom)
tamanho_hover_x = tamanho_original_x * 1.1;
tamanho_hover_y = tamanho_original_y * 1.1;

// Velocidade de interpolação
velocidade_zoom = 0.1;
